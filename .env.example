# 복사해서 .env 로 사용하세요. 모든 항목은 선택 사항입니다.

# Hugging Face 액세스 토큰 — gated 모델(예: google/embeddinggemma-300m) 다운로드에 필요
# HF_TOKEN=hf_xxx

# 실행 디바이스: auto | cpu | cuda | cuda:1 | rocm | mps   (GPU 설치는 docs/gpu.md)
DEVICE=auto

# 정밀도: auto | float32 | bfloat16   (EmbeddingGemma 계열은 float16 사용 금지)
DTYPE=auto

# 동시에 메모리에 올려둘 최대 모델 수 (초과 시 LRU 언로드). 임베딩 + 리랭커를 함께 쓰면 3 이상 권장
MAX_LOADED_MODELS=3

# 인코딩 기본 배치 크기
DEFAULT_BATCH_SIZE=16

# 앱 데이터(SQLite DB, 사용자 데이터셋, Qdrant 로컬 파일) 위치
# DATA_DIR=./data
# 앱 DB 를 PostgreSQL/MariaDB 로 쓰려면 (기본: data/app.db SQLite)
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/embedding_lab

# 모델 캐시 위치를 바꾸려면 (huggingface_hub 표준 환경변수)
# HF_HOME=D:/hf-cache

# ── 문서 검색(RAG) 벡터 DB ───────────────────────────────────────────────────
# 기본 저장소: qdrant | pgvector | mariadb   (인덱스마다 따로 고를 수도 있음)
VECTOR_STORE=qdrant
# 벡터 수가 이 이하인 인덱스는 근사(HNSW) 대신 정확 검색 (평가가 근사 오차에 흔들리지 않게)
# VECTOR_EXACT_MAX=20000
# 근사 검색 탐색 폭 (실제로는 max(이 값, top_k × 4))
# VECTOR_EF_SEARCH=200
# Qdrant 서버 주소. 비우면 서버 없이 로컬 파일 모드(DATA_DIR/qdrant)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# PostgreSQL + pgvector  (docker compose --profile pgvector up -d)
# PGVECTOR_URL=postgresql://embedding:embedding@localhost:5433/embedding_lab
# MariaDB 11.7+ VECTOR  (docker compose --profile mariadb up -d)
# MARIADB_URL=mysql://embedding:embedding@localhost:3307/embedding_lab

# 업로드 파일 최대 크기(MB), 인덱스 구축 배치, 리랭커 최대 입력 길이(토큰)
# MAX_UPLOAD_MB=100
# 영상 프레임 추출: 몇 초마다 한 장 / 최대 장수 (같은 장면은 자동 제외)
# VIDEO_FRAME_INTERVAL=2.0
# VIDEO_MAX_FRAMES=240
# INDEX_BATCH_SIZE=32
# RERANKER_MAX_LENGTH=1024

# ── LLM (문서 검색 평가 질문 자동 생성) ─────────────────────────────────────
# openai | anthropic. 비우면 키가 설정된 쪽을 사용 (둘 다 있으면 openai)
# LLM_PROVIDER=
# 모델 이름 → 서버 주소 (llama-server 는 서버당 모델 하나 — 양자화 · 소형 모델을 다른 포트에 띄울 때)
# OPENAI_MODEL_URLS={"gemma-4-e4b-q2": "http://127.0.0.1:8083/v1"}
# 로컬 GGUF 폴더 — 양자화 화면이 파일 목록을 보여 주고 llama-server 실행 명령(가중치 × KV 캐시 양자화)을 만든다
# LLM_MODELS_DIR=C:/llm-models
# OpenAI 호환 API: OpenAI, vLLM, Ollama(http://localhost:11434/v1), LM Studio 등
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Claude API
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# LLM_TIMEOUT=120
# 로컬·호환 서버에 '생각' 모드 끄기 요청 (Qwen3 계열 등)
# LLM_DISABLE_THINKING=true
