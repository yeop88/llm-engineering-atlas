# 복사해서 .env 로 사용하세요. 모든 항목은 선택 사항입니다.

# Hugging Face 액세스 토큰 — gated 모델(예: google/embeddinggemma-300m) 다운로드에 필요
# HF_TOKEN=hf_xxx

# 접근 토큰 — 서버 · 사내망에 올릴 때 설정 (비우면 인증 없음). 화면은 /login, API 는 Authorization: Bearer (docs/guides/deploy.md)
# API_TOKEN=
# AUTH_COOKIE_DAYS=14
# AUTH_COOKIE_SECURE=false
# 사용자별 토큰 · 그룹 · 역할 (권한별 검색 · 감사 로그). 그룹이 붙은 문서(문서 메타 acl)는 그 그룹 사용자만 검색된다. API_TOKEN 은 관리자
# API_USERS=[{"name": "hr-kim", "token": "…", "groups": ["hr"], "role": "user"}]

# ── 보안 · 가드레일 / 평가 · 관측 ────────────────────────────────────────────
# 답변 방어: off = 검사 · 기록만, mask = 개인정보 가림(기본), enforce = 인젝션 차단 · 의심 근거 제외 · 정책 위반 수정 · 거절
# GUARD_MODE=mask
# 요청 기록(트레이스 · 감사 로그) 보관 일수 (0 = 지우지 않음, 하루 한 번 정리)
# TRACE_RETENTION_DAYS=0
# 비용 대시보드 단가: 모델 이름 → [입력, 출력] 100만 토큰당 가격 (로컬 모델은 비우면 0)
# LLM_PRICES={"claude-sonnet-5-5": [3, 15]}
# 라이브러리 업그레이드를 감지하면 시작할 때 회귀 세트를 다시 잰다 (임베딩 · 검색만)
# REGRESSION_ON_UPGRADE=false
# 정기 점검: 몇 시간마다 다시 돌릴지(0 = 끔). 레드팀은 LLM 필요(37문항), 드리프트 · 회귀는 임베딩만
# WATCH_REDTEAM_HOURS=0
# WATCH_REDTEAM_MODE=enforce
# WATCH_DRIFT_HOURS=0
# WATCH_DRIFT_COLLECTION_ID=
# WATCH_REGRESSION_HOURS=0
# 정기 점검 경보를 보낼 주소(POST JSON {"source", "alerts": [{"kind", "run_id", "title", "message"}]}). 비우면 화면에만
# ALERT_WEBHOOK=

# ── 대화 · 메모리 ──────────────────────────────────────────────────────────
# 고객 프로필(보유 제품 · 지난 문의 요약, 개인정보는 가림) 보관 일수. 0 = 지우지 않음
# PROFILE_RETENTION_DAYS=90

# ── 문서 처리 ──────────────────────────────────────────────────────────────
# 폴더 수집 소스로 허용할 상위 경로들 (비우면 data/inbox 만)
# INGEST_ROOTS=["D:/shared/manuals"]

# ── 고객 AS 상담 ───────────────────────────────────────────────────────────
# 음성 문의 받아 적기: OpenAI 호환 /audio/transcriptions 서버 (예: whisper.cpp server)
# STT_URL=http://127.0.0.1:8090/v1
# STT_MODEL=whisper-1
# 상담원 이관 티켓을 보낼 외부 접수 시스템 (POST JSON). 비우면 앱의 티켓 화면에만 남김
# AS_TICKET_WEBHOOK=

# 라이브러리 버전이 지난 호환성 점검 때와 다르면 시작할 때 내려받은 모델을 자동 점검 (CPU 에서 몇 분)
# COMPAT_CHECK_ON_UPGRADE=false

# 실행 디바이스: auto | cpu | cuda | cuda:1 | rocm | mps   (GPU 설치는 docs/gpu.md)
DEVICE=auto

# 정밀도: auto | float32 | bfloat16   (EmbeddingGemma 계열은 float16 사용 금지)
DTYPE=auto

# 동시에 메모리에 올려둘 최대 모델 수 (초과 시 LRU 언로드). 임베딩 + 리랭커를 함께 쓰면 3 이상 권장
MAX_LOADED_MODELS=3

# 인코딩 기본 배치 크기
DEFAULT_BATCH_SIZE=16

# 앱 데이터(SQLite DB, 사용자 데이터셋, Qdrant 로컬 파일) 위치
# DATA_DIR=./data
# 앱 DB 를 PostgreSQL/MariaDB 로 쓰려면 (기본: data/app.db SQLite)
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/embedding_lab

# 모델 캐시 위치를 바꾸려면 (huggingface_hub 표준 환경변수)
# HF_HOME=D:/hf-cache

# ── 문서 검색(RAG) 벡터 DB ───────────────────────────────────────────────────
# 기본 저장소: qdrant | pgvector | mariadb   (인덱스마다 따로 고를 수도 있음)
VECTOR_STORE=qdrant
# 벡터 수가 이 이하인 인덱스는 근사(HNSW) 대신 정확 검색 (평가가 근사 오차에 흔들리지 않게)
# VECTOR_EXACT_MAX=20000
# 근사 검색 탐색 폭 (실제로는 max(이 값, top_k × 4))
# VECTOR_EF_SEARCH=200
# Qdrant 서버 주소. 비우면 서버 없이 로컬 파일 모드(DATA_DIR/qdrant)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# PostgreSQL + pgvector  (docker compose --profile pgvector up -d)
# PGVECTOR_URL=postgresql://embedding:embedding@localhost:5433/embedding_lab
# MariaDB 11.7+ VECTOR  (docker compose --profile mariadb up -d)
# MARIADB_URL=mysql://embedding:embedding@localhost:3307/embedding_lab
# 지식 그래프 Cypher(Text2Cypher)용 Neo4j (docker compose --profile neo4j up -d). 비우면 앱 DB 의 내장 그래프만(이웃 확장 · 커뮤니티는 동작)
# NEO4J_URL=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=embedding-graph
# 두 번째 Cypher 엔진 FalkorDB (docker compose --profile falkordb up -d) — 같은 그래프 · 같은 질문으로 Neo4j 와 비교
# FALKORDB_URL=redis://localhost:6380
# 엔진을 고르지 않은 요청이 쓸 기본 엔진(neo4j | falkordb). 비우면 연결이 설정된 쪽(둘 다면 neo4j)
# GRAPH_ENGINE=
# 규제 대응(RC1 · RC7): 국가법령정보 공동활용 API 키 — open.law.go.kr 에서 신청한 이메일 아이디. 비우면 법령 판 받기 · 개정 감시를 끔
# LAW_API_OC=
# 서비스 답변에 붙이는 AI 응답 고지(인공지능 기본법 제31조). 비우면 고지를 붙이지 않음(감사에서 실패)
# AI_NOTICE=AI 가 자료를 찾아 작성한 답변입니다. 법률 자문이 아니며, 사람의 검토를 요청할 수 있습니다.
# 통제 감사(RC8)를 몇 시간마다 다시 돌릴지(0 = 끔, LLM 없이 기록만 읽음)
# WATCH_AUDIT_HOURS=0
# 에이전트 상호운용(IO5): 세션 · 위임 하나의 도구 호출 수 · 시간(초) · 비용(달러, 0 = 상한 없음)
# INTEROP_MAX_CALLS=20
# INTEROP_MAX_SECONDS=120
# INTEROP_MAX_COST=0
# 코드 실행 샌드박스(IO2): Docker 가 있으면 이 이미지로 네트워크 없이(없으면 격리가 약한 별도 프로세스)
# SANDBOX_IMAGE=python:3.13-slim
# SANDBOX_TIMEOUT=10
# 외부 MCP 서버 · A2A 상대 에이전트 (JSON 목록)
# MCP_SERVERS=[{"name": "사내 위키", "url": "https://wiki.example/mcp", "token": "…"}]
# A2A_PEERS=[{"name": "법무 검토", "url": "https://legal.example", "token": "…"}]
# 엔터프라이즈 플랫폼(PF1): 사용자 · 테넌트당 분당 요청 상한(0 = 끔), 개별 상한
# RATE_LIMIT_PER_MIN=0
# RATE_LIMIT_OVERRIDES={"tenant:법무": 120, "batch-bot": 600}
# 후학습(P3~P7): LoRA SFT · DPO 기본 모델(Hub id, CPU 에서도 돌도록 작게) · GGUF 변환 스크립트(llama.cpp 저장소)
# POSTTRAIN_BASE_MODEL=Qwen/Qwen3-0.6B
# LLAMA_CONVERT_SCRIPT=C:/Users/me/llama.cpp-src/convert_hf_to_gguf.py
# 서빙 실측(S5): llama-server 실행 파일 — 있으면 앱이 KV 캐시 · 추측 디코딩 설정별로 띄워 비교(LLM_MODELS_DIR 의 GGUF)
# LLAMA_SERVER_BIN=C:/Users/me/llama.cpp/llama-server.exe
# 온디바이스(ED4 · ED5): 이 시간보다 오래 동기화하지 않은 기기를 '낡은 자료'로 표시
# EDGE_STALE_HOURS=72
# 장애 대응(PF6): 기본 LLM 이 멈추면 차례로 넘길 대체 모델
# LLM_FALLBACKS=[{"provider": "openai", "model": "gemma-4-e2b", "base_url": "http://127.0.0.1:8082/v1"}]
# 데이터 플라이휠(FW7): 배포 감시 주기(시간, 0 = 끔) — 나빠지면 자동 롤백. 좋을 때 자동으로 다음 비율로 올릴지
# FLYWHEEL_WATCH_HOURS=0
# FLYWHEEL_AUTO_ADVANCE=false
# 멀티에이전트(MA6): 쉬운 작성을 맡길 소형 모델(OpenAI 호환, 비우면 기본 LLM)
# SMALL_LLM_MODEL=gemma-4-e2b
# SMALL_LLM_BASE_URL=http://127.0.0.1:8082/v1
# 멀티모달 출력(MA8): 음성 합성 서버(OpenAI 호환 /audio/speech)
# TTS_URL=http://127.0.0.1:8880/v1
# TTS_MODEL=tts-1
# TTS_VOICE=alloy

# 업로드 파일 최대 크기(MB), 인덱스 구축 배치, 리랭커 최대 입력 길이(토큰)
# MAX_UPLOAD_MB=100
# 영상 프레임 추출: 몇 초마다 한 장 / 최대 장수 (같은 장면은 자동 제외)
# VIDEO_FRAME_INTERVAL=2.0
# VIDEO_MAX_FRAMES=240
# INDEX_BATCH_SIZE=32
# RERANKER_MAX_LENGTH=1024

# ── LLM (문서 검색 평가 질문 자동 생성) ─────────────────────────────────────
# openai | anthropic. 비우면 키가 설정된 쪽을 사용 (둘 다 있으면 openai)
# LLM_PROVIDER=
# 답변 근거 검증 방식: lexical(기본) · semantic · hybrid — RAG → 검증 보정 화면에서 사람 판정과의 일치도를 보고 고르세요
# ANSWER_VERIFY_METHOD=lexical
# VERIFY_MODEL=nlpai-lab/KURE-v1
# VERIFY_SEMANTIC_OK=0.80
# 질문 관련성: 답변 문장이 질문에 답하는가(근거에 있어도 질문과 상관없으면 '관련 낮음'). 기준은 사람 판정 28개로 고른 잠정값
# ANSWER_RELEVANCE=true
# VERIFY_RELEVANCE_OK=0.68
# 모델 이름 → 서버 주소 (llama-server 는 서버당 모델 하나 — 양자화 · 소형 모델을 다른 포트에 띄울 때)
# OPENAI_MODEL_URLS={"gemma-4-e4b-q2": "http://127.0.0.1:8083/v1"}
# 로컬 GGUF 폴더 — 양자화 화면이 파일 목록을 보여 주고 llama-server 실행 명령(가중치 × KV 캐시 양자화)을 만든다
# LLM_MODELS_DIR=C:/llm-models
# OpenAI 호환 API: OpenAI, vLLM, Ollama(http://localhost:11434/v1), LM Studio 등
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Claude API
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# LLM_TIMEOUT=120
# 로컬·호환 서버에 '생각' 모드 끄기 요청 (Qwen3 계열 등)
# LLM_DISABLE_THINKING=true
