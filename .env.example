# 복사해서 .env 로 사용하세요. 모든 항목은 선택 사항입니다.

# Hugging Face 액세스 토큰 — gated 모델(예: google/embeddinggemma-300m) 다운로드에 필요
# HF_TOKEN=hf_xxx

# 실행 디바이스: auto | cpu | cuda | mps
DEVICE=auto

# 정밀도: auto | float32 | bfloat16   (EmbeddingGemma 계열은 float16 사용 금지)
DTYPE=auto

# 동시에 메모리에 올려둘 최대 모델 수 (초과 시 LRU 언로드)
MAX_LOADED_MODELS=2

# 인코딩 기본 배치 크기
DEFAULT_BATCH_SIZE=16

# 앱 데이터(SQLite DB, 사용자 데이터셋) 위치
# DATA_DIR=./data

# 모델 캐시 위치를 바꾸려면 (huggingface_hub 표준 환경변수)
# HF_HOME=D:/hf-cache
